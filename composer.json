{
    "name": "frodeborli/phame",
    "description": "An experiment: an event-driven game engine in PHP (scene graph, exact physics, remote views), built to stress-test phasync and Swerve.",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Frode Børli", "email": "frode@ennerd.com"}],
    "require": {
        "php": "^8.4",
        "ext-ffi": "*",
        "ext-zlib": "*",
        "phasync/phasync": "^2.0.0-beta10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Phame\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Phame\\Tests\\": "tests/"}
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
