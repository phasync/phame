<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true" failOnRisky="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="phame"><directory>tests</directory></testsuite>
    </testsuites>
    <groups><exclude><group>baseline-failure</group><group>soak</group></exclude></groups>
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
</phpunit>
